{
  "doctype": "DocType",
  "name": "Sales Contract",
  "module": "Contract Operations",
  "autoname": "naming_series:",
  "engine": "InnoDB",
  "is_submittable": 1,
  "track_changes": 1,
  "allow_rename": 0,
  "field_order": [
    "naming_series",
    "contract_title",
    "external_number",
    "contract_group",
    "billing_flow",
    "company",
    "customer",
    "currency",
    "contract_amount",
    "signing_date",
    "start_date",
    "end_date",
    "contract_file",
    "notes",
    "amended_from",
    "planning_section",
    "planning_html",
    "renewal_section",
    "renewal_mode",
    "renewal_enabled",
    "renewal_owner",
    "renewal_notice_days",
    "renewal_column",
    "renewal_months",
    "renewal_review_date",
    "renewal_leads",
    "renewal_clause",
    "renewal_health",
    "renewal_records_section",
    "renewal_html"
  ],
  "fields": [
    {
      "fieldname": "naming_series",
      "label": "编号规则",
      "fieldtype": "Select",
      "options": "SC-.YYYY.-.#####",
      "default": "SC-.YYYY.-.#####",
      "reqd": 1
    },
    {
      "fieldname": "contract_title",
      "label": "合同名称",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "external_number",
      "label": "外部合同编号",
      "fieldtype": "Data"
    },
    {
      "fieldname": "contract_group",
      "label": "所属合同组",
      "fieldtype": "Link",
      "options": "Contract Group",
      "allow_on_submit": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "company",
      "label": "公司",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "customer",
      "label": "客户",
      "fieldtype": "Link",
      "options": "Customer",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "currency",
      "label": "币种",
      "fieldtype": "Link",
      "options": "Currency",
      "default": "CNY",
      "reqd": 1
    },
    {
      "fieldname": "contract_amount",
      "label": "合同含税金额",
      "fieldtype": "Currency",
      "options": "currency",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "signing_date",
      "label": "签订日期",
      "fieldtype": "Date",
      "description": "按原件填写；无法确认时留空，不以录入日代替签订日。"
    },
    {
      "fieldname": "start_date",
      "label": "履行开始日期",
      "fieldtype": "Date"
    },
    {
      "fieldname": "end_date",
      "label": "履行结束日期",
      "fieldtype": "Date"
    },
    {
      "fieldname": "contract_file",
      "label": "合同附件",
      "fieldtype": "Attach"
    },
    {
      "fieldname": "notes",
      "label": "备注",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "amended_from",
      "label": "修订自",
      "fieldtype": "Link",
      "options": "Sales Contract",
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "planning_section",
      "label": "开票与收款计划",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "planning_html",
      "label": "逐期计划与实际票款",
      "fieldtype": "HTML"
    },
    {
      "fieldname": "billing_flow",
      "label": "票款顺序",
      "fieldtype": "Select",
      "options": "先票后款\n先款后票",
      "default": "先票后款",
      "allow_on_submit": 1,
      "in_list_view": 1,
      "description": "已有计划后不可切换；历史票款不自动回填计划。"
    },
    {
      "fieldname": "renewal_section",
      "label": "续签与到期管理",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "renewal_mode",
      "label": "续签方式",
      "fieldtype": "Select",
      "options": "待核实\n到期协商续签\n自动续期\n到期终止\n无固定期限",
      "default": "待核实",
      "in_standard_filter": 1,
      "allow_on_submit": 1
    },
    {
      "fieldname": "renewal_enabled",
      "label": "启用续签提醒",
      "fieldtype": "Check",
      "default": "0",
      "description": "核对条款并填写负责人后启用。每日自动检查；历史合同默认不启用。",
      "allow_on_submit": 1
    },
    {
      "fieldname": "renewal_owner",
      "label": "合同负责人",
      "fieldtype": "Link",
      "options": "User",
      "in_standard_filter": 1,
      "allow_on_submit": 1
    },
    {
      "fieldname": "renewal_notice_days",
      "label": "提前通知天数（自然日）",
      "fieldtype": "Int",
      "default": "0",
      "description": "办理截止日＝合同结束日期减提前通知天数。自动续期合同按原件填写不续签通知期限。",
      "allow_on_submit": 1
    },
    {
      "fieldname": "renewal_months",
      "label": "每次自动续期月数",
      "fieldtype": "Int",
      "default": "12",
      "depends_on": "eval:doc.renewal_mode === \"自动续期\"",
      "allow_on_submit": 1
    },
    {
      "fieldname": "renewal_review_date",
      "label": "复核日期（无固定期限）",
      "fieldtype": "Date",
      "depends_on": "eval:doc.renewal_mode === \"无固定期限\"",
      "allow_on_submit": 1
    },
    {
      "fieldname": "renewal_leads",
      "label": "提醒提前量（自然日）",
      "fieldtype": "Data",
      "default": "30,7,1,0",
      "description": "相对办理截止日，如30,7,1,0。逾期未处理每7天提醒一次。",
      "allow_on_submit": 1
    },
    {
      "fieldname": "renewal_clause",
      "label": "续签条款原文及依据",
      "fieldtype": "Small Text",
      "allow_on_submit": 1
    },
    {
      "fieldname": "renewal_health",
      "label": "提醒配置状态",
      "fieldtype": "Data",
      "read_only": 1,
      "in_list_view": 1,
      "allow_on_submit": 1
    },
    {
      "fieldname": "renewal_html",
      "label": "续签周期与办理记录",
      "fieldtype": "HTML"
    },
    {
      "fieldname": "renewal_column",
      "label": "提醒规则",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "renewal_records_section",
      "label": "续签周期与办理记录",
      "fieldtype": "Section Break"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "share": 1
    },
    {
      "role": "Sales Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "share": 1
    },
    {
      "role": "Accounts Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "share": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "links": [],
  "actions": [],
  "states": []
}
